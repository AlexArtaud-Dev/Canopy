# Copy to docker/.env and replace every value. Never commit the real file.

# --- Database (one role per app; see docs/dev/architecture.md) ---
CANOPY_DB_ADMIN_PASSWORD=change-me-admin
CANOPY_WEB_DB_PASSWORD=change-me-web
CANOPY_ENGINE_DB_PASSWORD=change-me-engine

# --- Secrets at rest (TOTP secrets, SMTP password…) ---
# 32 random bytes in base64: openssl rand -base64 32. Back it up: without it, stored secrets are lost.
CANOPY_ENCRYPTION_KEY=
# During a rotation, list the old key(s) here (comma-separated) until values are re-encrypted.
CANOPY_ENCRYPTION_KEY_PREVIOUS=

# --- Development only (compose.dev.yaml) ---
CANOPY_DEV_DB_PORT=5432

# --- Production stack (compose.yaml) ---
# Interface and port the web app is published on. Keep 127.0.0.1 behind a reverse proxy.
CANOPY_HTTP_BIND=127.0.0.1
CANOPY_HTTP_PORT=3000
# Host user that owns the files the engine creates, and the umask applied to them.
PUID=1000
PGID=1000
UMASK=022
# Example data folder mounted at /srv/canopy/root/data (add more mounts in compose.yaml).
CANOPY_DATA_DIR=./data
CANOPY_LOG_LEVEL=info
# Reverse proxies allowed to set X-Forwarded-For / CF-Connecting-IP (comma-separated CIDRs).
# Example for a proxy on the Docker host network: 172.16.0.0/12
CANOPY_TRUSTED_PROXIES=
