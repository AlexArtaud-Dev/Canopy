{
  "name": "canopy",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm test:scripts",
    "test:scripts": "node --test --experimental-test-coverage --test-coverage-include=scripts/release/release.lib.mjs --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 scripts/release/release.lib.test.mjs",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "contracts:gen": "pnpm -r --if-present contracts:gen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:i18n": "node scripts/ci/check-i18n.mjs",
    "check:changelog": "node scripts/ci/check-changelog.mjs"
  },
  "devDependencies": {
    "@canopy/config": "workspace:*",
    "@canopy/contracts": "workspace:*",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
