{
  "name": "@canopy/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./zod": {
      "types": "./dist/zod.gen.d.ts",
      "default": "./dist/zod.gen.js"
    }
  },
  "scripts": {
    "contracts:gen": "pnpm gen:ts && pnpm gen:go && pnpm build",
    "gen:ts": "openapi-ts",
    "gen:go": "go -C ../../apps/engine tool oapi-codegen -config ../../packages/contracts/oapi-codegen.yaml ../../packages/contracts/openapi.yaml",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@canopy/config": "workspace:*",
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "6.0.3"
  }
}
